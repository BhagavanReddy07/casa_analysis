# Videos — samples and every generated output. 56 MB and growing with each
# run; the EC2 instance keeps its own copies and the deploy never touches
# them, so they must stay out of history.
videos/

# Phase 1 training run: curves, confusion matrices, last.pt. 18 MB of
# artifacts nothing in the pipeline reads. models/best.pt IS committed —
# it is 5.4 MB and the app cannot run without it.
sperm_pose_baseline/

# Datasets
data/raw/
data/yolo_pose/

__pycache__/
*.py[cod]
.venv/
venv/
.env

# Private keys — a .pem dropped in the repo to SSH the instance must never be
# committed, and the filename it lands under is not predictable.
*.pem
*.key

sperm1/
sperm2/
sperm3/

# Streamlit local secrets (config.toml itself is committed)
.streamlit/secrets.toml

.vscode/
.idea/
.DS_Store
Thumbs.db
